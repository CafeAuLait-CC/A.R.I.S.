# Copy locally to .env; use independent random tokens, never commit real values.
ARIS_ENVIRONMENT=development
ARIS_DATABASE_URL=sqlite+pysqlite:///.local/aris.db
ARIS_READ_TOKEN=replace-with-independent-read-token
ARIS_AGENT_CREDENTIALS={"agent-node-1":{"node_id":"node-1","token":"replace-with-node-only-token"}}
ARIS_STALE_AFTER_SECONDS=60
ARIS_OFFLINE_AFTER_SECONDS=180
