ARIS_AGENT_ID=agent-node-1
ARIS_AGENT_NODE_ID=node-1
ARIS_AGENT_TOKEN=replace-with-node-only-token
# HTTPS control plane URL, or loopback through an SSH reverse tunnel.
ARIS_AGENT_API_URL=http://127.0.0.1:8000
ARIS_AGENT_SPOOL_PATH=.local/agent-spool.sqlite3
ARIS_AGENT_INTERVAL_SECONDS=15
# Optional outbound WebSocket; high-frequency sampling still needs an active viewer lease.
ARIS_AGENT_LIVE_ENABLED=false
# Bound catch-up memory/work; each nonempty historical batch still makes progress.
ARIS_AGENT_FLUSH_MAX_MESSAGES=100
ARIS_AGENT_FLUSH_BUDGET_SECONDS=5
